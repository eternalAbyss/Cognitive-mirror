{
  "name": "@cm/reasoning-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "brief": "tsx src/brief-run.ts",
    "maintain": "tsx src/maintain-run.ts",
    "build": "tsup src/index.ts --format esm --clean",
