{
  "name": "cognitive-mirror",
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first second brain: ingests your activity into a self-managing knowledge graph that Claude can reason over.",
  "license": "MIT",
  "author": "Utkarsh Singh",
  "homepage": "https://github.com/eternalAbyss/Cognitive-mirror#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eternalAbyss/Cognitive-mirror.git"
  },
  "bugs": "https://github.com/eternalAbyss/Cognitive-mirror/issues",
  "keywords": [
    "pkm",
    "second-brain",
    "knowledge-graph",
    "mcp",
    "claude",
    "local-first",
    "falkordb"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cognitive-mirror": "./dist/cli.js"
  },
  "files": ["dist", "assets", "README.md", "LICENSE"],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "//": "Runtime deps are the visualiser's only. The four backend services are bundled with their @cm/* workspace packages inlined (tsup noExternal), so they need nothing at install time. The Next standalone server cannot be bundled the same way, and shipping its node_modules would both break (npm strips pnpm's symlinks) and hardcode one platform's native binaries \u2014 so npm installs these instead.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.0",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "falkordb": "^6.2.7",
    "hono": "^4.6.16",
    "next": "^15.1.4",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "rss-parser": "^3.13.0",
    "three": "^0.171.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cm/graph-core": "workspace:*",
    "@cm/ingestion": "workspace:*",
    "@cm/mcp-server": "workspace:*",
    "@cm/reasoning-daemon": "workspace:*",
    "@cm/shared": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "vitest": "^3.2.6"
  }
}
