{
  "name": "cognitive-mirror",
  "version": "0.1.1",
  "type": "module",
  "description": "A local-first second brain: ingests your activity into a self-managing knowledge graph that Claude can reason over.",
  "license": "MIT",
  "author": "Utkarsh Singh",
  "homepage": "https://github.com/eternalAbyss/Cognitive-mirror#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eternalAbyss/Cognitive-mirror.git"
  },
  "bugs": "https://github.com/eternalAbyss/Cognitive-mirror/issues",
  "keywords": [
    "pkm",
    "second-brain",
    "knowledge-graph",
    "mcp",
    "claude",
    "local-first",
    "falkordb"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cognitive-mirror": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "//": "Runtime deps are the visualiser's only. The four backend services are bundled with their @cm/* workspace packages inlined (tsup noExternal), so they need nothing at install time. The Next standalone server cannot be bundled the same way, and shipping its node_modules would both break (npm strips pnpm's symlinks) and hardcode one platform's native binaries — so npm installs these instead.",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "falkordb": "^6.9.2",
    "hono": "^4.13.14",
    "next": "^16.4.3",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "rss-parser": "^3.13.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cm/graph-core": "workspace:*",
    "@cm/ingestion": "workspace:*",
    "@cm/mcp-server": "workspace:*",
    "@cm/reasoning-daemon": "workspace:*",
    "@cm/shared": "workspace:*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
