# ── Anthropic (autonomous reasoning path / daemon) ──────────────────────────
# Local dev: set here. On the Mac Mini, prefer macOS Keychain (see packages/shared/src/keychain.ts).
ANTHROPIC_API_KEY=

# ── GitHub ingestion ────────────────────────────────────────────────────────
GITHUB_TOKEN=
# Comma-separated owner/repo list to poll
GITHUB_REPOS=octocat/Hello-World
GITHUB_POLL_INTERVAL_MS=300000

# ── FalkorDB (graph + vectors; single data store) ───────────────────────────
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=cognitive_mirror

# ── Ollama embeddings ───────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
# Must match the model's output dimension (nomic-embed-text = 768).
EMBED_DIM=768
# Chunking
CHUNK_TOKENS=512
CHUNK_OVERLAP=64

# ── Service ports (all bound to 127.0.0.1) ──────────────────────────────────
GRAPH_CORE_PORT=4001
INGESTION_PORT=4002
MCP_PORT=4003
DAEMON_PORT=4005
# The visualiser's port is set in apps/visualiser/package.json (4004).

# ── Model tiering (config-driven; never hardcode prices) ────────────────────
MODEL_ENRICH=claude-haiku-4-5-20251001
MODEL_ADJUDICATE=claude-sonnet-4-6
MODEL_INSIGHT=claude-opus-4-8

# ── Budget / circuit breaker (USD) ──────────────────────────────────────────
DAILY_BUDGET_USD=5
MONTHLY_BUDGET_USD=100

# ── Durable job queue ───────────────────────────────────────────────────────
QUEUE_DB_PATH=./.data/queue.sqlite
# Persisted budget-breaker spend (survives daemon restarts).
BUDGET_STATE_PATH=./.data/budget.json

# ── Ingestion webhook auth ─────────────────────────────────────────────────
# The /ingest webhook FAILS CLOSED: with no token set it returns 401. Generate
# one with `openssl rand -hex 32` and give the same value to the Apple Shortcut
# and the browser extension. It must be sent as `Authorization: Bearer <token>`.
INGEST_TOKEN=
# Set to true ONLY for local development to accept unauthenticated /ingest posts.
ALLOW_ANONYMOUS_INGEST=false

# ── Ntfy alerts (set a topic to enable phone notifications) ─────────────────
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# ── Daily world brief ───────────────────────────────────────────────────────
BRIEF_THRESHOLD=0.45
BRIEF_MAX_OBSERVATIONS=5
BRIEF_CRON=0 7 * * *
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
# Comma-separated RSS/Atom feed URLs
RSS_FEEDS=

# ── Daemon health probe ─────────────────────────────────────────────────────
HEALTH_INTERVAL_MS=120000

# ── Maintenance engine (§9) — distance is cosine DISTANCE (lower = closer),
#    calibrated for nomic-embed-text (not the doc's 0.93 similarity figure) ────
MAINTENANCE_CRON=30 3 * * *
MERGE_CANDIDATE_DISTANCE=0.3
MAX_INSIGHTS_PER_RUN=3
ARCHIVE_INACTIVITY_DAYS=30
CONCEPT_TARGET_MIN=300
CONCEPT_TARGET_MAX=600

# ── Optional: per-model price overrides for the budget breaker ─────────────
# USD per 1M tokens. The models above already have built-in prices (see
# DEFAULT_MODEL_PRICES in packages/shared/src/config.ts) — set this only to
# correct a price that has changed, or to add a model of your own. Values here
# are merged over the built-ins, so list only what differs. A model with no
# price is counted as $0 and the daemon warns about it on first use.
# MODEL_PRICES={"claude-opus-4-8":{"in":5,"out":25}}
